# ===== 必須 =====
# 管理画面ログインパスワード
ADMIN_PASSWORD=change-me
# セッションCookie署名用のランダム文字列（openssl rand -hex 32 などで生成）
SESSION_SECRET=please-generate-a-long-random-string
# 公開URL（Webhook・計測リンク・フォームURLの生成に使用）
BASE_URL=http://localhost:3000

# ===== LINE Messaging API（LINE Developers コンソール） =====
LINE_CHANNEL_SECRET=
# 未設定ならドライラン（送信内容をログに出すだけ）
LINE_CHANNEL_ACCESS_TOKEN=
# 友だち追加URL（例: https://line.me/R/ti/p/@xxxx）流入経路分析で使用
LINE_ADD_FRIEND_URL=

# ===== 流入経路分析（任意・無料）: LINEログインチャネル + LIFFアプリ =====
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# ===== ログインなしの閲覧（読み取り専用・任意） =====
# 1 でトップに「ログインせずに見る」を表示。友だちの名前やトークも見えるので、本番の友だちが入る前に 0 に戻す
GUEST_VIEW_ENABLED=0

# ===== 管理画面の「LINEでログイン」（任意）: 上と同じ LINEログインチャネルを使う =====
# チャネルのコールバックURLに https://<あなたのドメイン>/api/auth/line/callback を登録
LINE_LOGIN_CHANNEL_SECRET=
# ログインを許可する LINE ユーザーID（カンマ区切り。分からなければ一度ログインすると画面に表示される）
ADMIN_LINE_USER_IDS=

# ===== AI自動応答（任意・従量課金。未設定なら0円） =====
ANTHROPIC_API_KEY=

# ===== DB =====
# ローカルファイル（VPS向け）
DATABASE_URL=file:./data/app.db
# Turso（サーバーレス向け・無料枠）を使う場合:
# DATABASE_URL=libsql://xxxx.turso.io
# DATABASE_AUTH_TOKEN=

# ===== 定期実行 =====
# 外部cronから /api/cron を呼ぶ時の認証キー
CRON_SECRET=
# 1 にするとサーバー内蔵の1分間隔ジョブを無効化（サーバーレスでは1に）
DISABLE_INTERNAL_CRON=0
