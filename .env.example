# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API (GPT, Whisper, Sora)
OPENAI_API_KEY=your-openai-api-key

# Kling AI
KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key

# Runway ML
RUNWAY_API_KEY=your-runway-api-key

# Model settings
OPENAI_PROMPT_MODEL=gpt-4o
OPENAI_SORA_MODEL=sora-2

# Affiliate Pilot AI 連携（npm start -- hub-sync）
HUB_URL=http://localhost:3000
HUB_TOKEN=affiliate-pilot の PIPELINE_TOKEN と同じ値
