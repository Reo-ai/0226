# 管理画面ログインパスワード（必須）
ADMIN_PASSWORD=change-me
# セッションCookie署名用のランダム文字列（必須）
SESSION_SECRET=please-generate-a-long-random-string

# LINE Messaging API（LINE Developers コンソールで取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 公開URL（クリック計測リンクの生成に使用）
BASE_URL=http://localhost:3000

# AI自動応答（Claude）
ANTHROPIC_API_KEY=

# 外部cronから /api/cron を叩く場合の認証キー
CRON_SECRET=
# 1 にするとサーバー内蔵の1分間隔ジョブを無効化（外部cronを使う場合）
DISABLE_INTERNAL_CRON=0

# SQLiteファイルの場所
DATABASE_PATH=./data/app.db
