# SQLite のファイル（Git にコミットしない）
DATABASE_URL="file:./dev.db"

# ローカルAI（Ollama）。未起動でもアプリは動きます（テンプレート・ルールで代替）
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# 任意: Claude を使う場合のみ（有料）。空なら使いません
ANTHROPIC_API_KEY=""

# 任意: 計測リンクのURL（スマホからLANで使うときは http://PCのIP:3000）
APP_BASE_URL=""

# 任意: 動画パイプライン連携（リポジトリ直下の npm start -- hub-sync）
PIPELINE_TOKEN=""

# 任意: LAN 外に公開するときは必ず設定（ログインが必要になります）
APP_PASSWORD=""
